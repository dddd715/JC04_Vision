# JC04 Vision resource test configuration.
# Keep this file identical on all boards participating in a comparison.

ROS_SETUP=/opt/ros/humble/setup.bash
JC04_WORKSPACE_SETUP=/home/nvidia/JC04/JC04Dev/install/setup.bash

# Core resource sampling does not create ROS image subscribers.
DEFAULT_SAMPLE_INTERVAL_MS=500
LONG_SAMPLE_INTERVAL_MS=1000
DEFAULT_WARMUP_SECONDS=120
SERVICE_START_SETTLE_SECONDS=8
ROS_COMMAND_TIMEOUT_SECONDS=20
ENFORCE_ROS_DOMAIN_MATCH=1

# ROS probes run after core resource sampling and therefore do not affect the
# CPU/GPU/RAM figures in the main result table.
ENABLE_ROS_PROBES=1
ROS_PROBE_SECONDS=30
ROS_PROBE_TOPICS="/camera/camera/color/image_raw /camera/camera/aligned_depth_to_color/image_raw /face_detect/image /pose_detect/image /jc04_wave_sign /output_msg /obstacle_detected"

# Informational camera configuration recorded in every report.
EXPECTED_CAMERA_RESOLUTION=640x480
EXPECTED_CAMERA_FPS=15

# Stability warning threshold; FPS is intentionally not a pass/fail metric.
MIN_AVAILABLE_MEMORY_MB=512
# Applied as a warning only for captures of at least one hour.
MAX_MEMORY_GROWTH_MB_PER_HOUR=40

# Restore the active/inactive state of all five services after a test. Runtime
# enable flags cannot be queried, so restored recognition nodes are reset false.
RESTORE_INITIAL_SERVICE_STATE=1

# The runner is unattended by default. Scene cases use a short countdown and
# never wait for an operator to press Enter.
NON_INTERACTIVE=1
SCENE_SETTLE_SECONDS=10

# Results are ignored by Git. Override with an absolute path when collecting to
# a mounted disk or central results directory.
RESULTS_ROOT=
