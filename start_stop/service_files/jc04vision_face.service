[Unit]
Description=JC04 Face Model Node
Wants=network-online.target camera.service
After=network-online.target camera.service

[Service]
Type=simple
User=nvidia
WorkingDirectory=/home/nvidia/JC04_Vision/Face/yolov8-face
ExecStart=/home/nvidia/JC04_Vision/start_stop/jc04vision_face.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
