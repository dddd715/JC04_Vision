[Unit]
Description=JC04 Pose Track Vision Node
Wants=camera.service jc04vision_PoseAvoid.service
After=camera.service jc04vision_PoseAvoid.service

[Service]
Type=simple
User=nvidia
WorkingDirectory=/home/nvidia/JC04_Vision/Face/yolov8-face
ExecStart=/home/nvidia/JC04_Vision/start_stop/jc04vision_PoseTrack.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
